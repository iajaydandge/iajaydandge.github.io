---
// @see https://docs.astro.build/en/basics/astro-components/
// @see https://github.com/iajaydandge/iajaydandge.github.io/blob/main/AGENTS.md

import ThemeToggle from "@/components/theme-toggle.astro";

const navItems = [
  { path: "/", name: "home" },
  { path: "/writing", name: "writing" },
  { path: "/library", name: "library" },
  { path: "/about", name: "about" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<aside class="mb-16 tracking-tight">
  <div class="lg:sticky lg:top-20">
    <nav class="flex items-center justify-between relative px-0 pb-0" id="nav">
      <div class="flex items-center gap-1 sm:gap-2 -ml-2">
        {
          navItems.map(({ path, name }) => {
            const isActive = pathname === path || (path !== "/" && pathname.startsWith(path));
            return (
              <a
                href={path}
                class:list={[
                  "transition-colors py-1 px-2 text-sm font-medium",
                  isActive
                    ? "text-neutral-900 dark:text-neutral-100 font-semibold"
                    : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
                ]}
              >
                {name}
              </a>
            );
          })
        }
      </div>
      <ThemeToggle />
    </nav>
  </div>
</aside>
