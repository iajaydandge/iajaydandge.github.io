---
// @see https://docs.astro.build/en/basics/astro-pages/
// @see https://github.com/iajaydandge/iajaydandge.github.io/blob/main/AGENTS.md
// @see https://lucide.dev/guide/packages/lucide-astro

import Layout from "@/layouts/layout.astro";
import { ArrowUpRight, Github, Twitter, Linkedin, Mail } from "lucide-astro";

const projects = [
  {
    name: "Contests",
    href: "https://contests.ajaydandge.dev/",
    desc: "Track upcoming competitive programming contests",
  },
  {
    name: "CodeRun",
    href: "https://coderun.ajaydandge.dev/",
    desc: "Online code runner to write, run, and test code",
  },
  {
    name: "Burrow",
    href: "https://burrow.ajaydandge.dev/",
    desc: "CLI to query PostgreSQL and MySQL databases directly or via SSH tunnel",
  },
  {
    name: "Password",
    href: "https://password.ajaydandge.dev/",
    desc: "Local-first password manager",
  },
  {
    name: "Claude Usage Plugin",
    href: "https://github.com/iajaydandge/claude-usage-plugin",
    desc: "Per-user token, cost, and session tracking in Claude Code",
  },
  {
    name: "Slate",
    href: "https://slate.ajaydandge.dev/",
    desc: "Minimalist canvas tool",
  },
  {
    name: "CLI Wordle",
    href: "https://pypi.org/project/cli-wordle/",
    desc: "Wordle clone in the terminal on PyPI",
  },
];

const experiments = [
  {
    name: "Mazes",
    href: "https://mazes.ajaydandge.dev/",
    desc: "Maze generation and pathfinding algorithms",
  },
  {
    name: "Photo Magic",
    href: "https://github.com/iajaydandge/photo-magic",
    desc: "Encrypt and decrypt images using LFSR pseudo-random generation",
  },
  {
    name: "Guess the Number",
    href: "https://github.com/iajaydandge/guess-the-number",
    desc: "Number guessing game written in different programming languages",
  },
  {
    name: "Slots",
    href: "https://slots.ajaydandge.dev/",
    desc: "Checks available court slots where we go to play badminton",
  },
  {
    name: "Gravity Falls",
    href: "https://pypi.org/project/gravity-falls/",
    desc: "First published Python package with classic ciphers (Caesar, etc.)",
  },
];

const connectLinks = [
  {
    label: "GitHub",
    href: "https://github.com/iajaydandge",
    type: "github",
  },
  {
    label: "X",
    href: "https://x.com/iajaydandge",
    type: "x",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/ajaydandge",
    type: "linkedin",
  },
  {
    label: "Email",
    href: "mailto:contact@ajaydandge.dev",
    type: "email",
  },
];
---

<Layout
  title="About"
  description="Ajay Dandge — developer, curious human, building software and exploring ideas."
>
  <section>
    <h1 class="font-semibold text-2xl mb-4 tracking-tighter">About</h1>

    <div class="space-y-4 text-neutral-800 dark:text-neutral-200">
      <p>
        I'm Ajay. I build software, explore ideas, and currently work as an AI
        Engineer.
      </p>
      <p>
        Outside of work, I spend my time playing badminton, watching anime,
        reading fiction (mostly), and sketching. I also enthusiastically follow
        cricket and love following sports in general.
      </p>
    </div>

    <hr class="my-8 border-neutral-200 dark:border-neutral-800" />

    {/* Things I've Made */}
    <div class="mb-8">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-4">
        Things I've made
      </h2>

      {/* Projects & Tools */}
      <div class="mb-6">
        <h3 class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-3">
          Projects & tools
        </h3>
        <ul class="space-y-2 text-sm">
          {
            projects.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center hover:underline underline-offset-4 text-neutral-900 dark:text-neutral-100 font-medium"
                >
                  <span>{item.name}</span>
                  <ArrowUpRight class="w-3 h-3 ml-0.5 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
                </a>
                <span class="text-neutral-500 dark:text-neutral-400">
                  {" "}— {item.desc}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Experiments */}
      <div>
        <h3 class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-3">
          Experiments
        </h3>
        <ul class="space-y-2 text-sm">
          {
            experiments.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center hover:underline underline-offset-4 text-neutral-900 dark:text-neutral-100 font-medium"
                >
                  <span>{item.name}</span>
                  <ArrowUpRight class="w-3 h-3 ml-0.5 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
                </a>
                <span class="text-neutral-500 dark:text-neutral-400">
                  {" "}— {item.desc}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="my-8 border-neutral-200 dark:border-neutral-800" />

    {/* Connect Links with Lucide Icons */}
    <div>
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-4">
        Connect
      </h2>
      <div class="flex flex-wrap gap-4 text-sm">
        {
          connectLinks.map((link) => (
            <a
              href={link.href}
              target={link.type === "email" ? undefined : "_blank"}
              rel={link.type === "email" ? undefined : "noopener noreferrer"}
              class="group inline-flex items-center gap-1.5 hover:underline underline-offset-4 text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white"
            >
              {link.type === "github" && (
                <Github class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
              )}
              {link.type === "x" && (
                <Twitter class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
              )}
              {link.type === "linkedin" && (
                <Linkedin class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
              )}
              {link.type === "email" && (
                <Mail class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
              )}
              <span>{link.label}</span>
              <ArrowUpRight class="w-3 h-3 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors shrink-0" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
