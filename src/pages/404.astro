---
// @see https://docs.astro.build/en/basics/astro-pages/#custom-404-page
// @see https://github.com/iajaydandge/iajaydandge.github.io/blob/main/AGENTS.md

import Layout from "@/layouts/layout.astro";
---

<Layout
  title="404 — Page Not Found"
  description="Whatever was here isn't anymore — maybe it moved, was rewritten, or never existed in the first place."
>
  <section class="space-y-4">
    <h1 class="text-2xl font-semibold tracking-tighter text-neutral-900 dark:text-neutral-100">
      404 — Page not found
    </h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
      Whatever was here isn't anymore — maybe it moved, was rewritten, or never existed in the first place.
    </p>
    <div class="pt-2 flex flex-wrap gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <a
        href="/"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 underline underline-offset-4"
      >
        ← Back to home
      </a>
      <a
        href="/llms.txt"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 underline underline-offset-4 font-mono"
      >
        llms.txt
      </a>
      <a
        href="/contact"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 underline underline-offset-4"
      >
        contact
      </a>
      <a
        href="/rss.xml"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 underline underline-offset-4"
      >
        rss
      </a>
    </div>
  </section>
</Layout>
